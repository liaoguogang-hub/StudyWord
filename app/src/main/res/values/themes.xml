<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StudyWord" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/deep_blue</item>
        <item name="colorPrimaryVariant">@color/sky_blue</item>
        <item name="colorSecondary">@color/tangerine</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/Theme.StudyWord.Dialog</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>
    </style>

    <style name="Theme.StudyWord.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/deep_blue</item>
        <item name="colorSecondary">@color/tangerine</item>
    </style>

    <!--
        v1.4.4:UI 简约化 — 删 v1.4.1/v1.4.3 期间加的几个属性
        保留 UnelevatedButton 父样式(v1.4.3 修的点击 bug 不能丢):
        - backgroundTint=@null / android:backgroundTint=@null — 让 layer-list 背景生效
        - stateListAnimator=@null + elevation=0dp — 修点击时 elevation 动画拦截触摸事件
        实测 v1.4.0 单层 shape + UnelevatedButton + 这些属性 = 可点击且视觉简约
    -->
    <style name="Widget.StudyWord.PrimaryButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.StudyWord.SecondaryButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/deep_blue</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.StudyWord.DifficultyChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipBackgroundColor">@color/chip_state_color</item>
        <item name="chipStrokeColor">@color/deep_blue</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="rippleColor">@color/bubble_pink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.StudyWord.UnknownButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_button_unknown</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 游戏页 4 选 1 大字选项按钮 -->
    <style name="Widget.StudyWord.OptionButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_option_default</item>
        <item name="android:textColor">@color/deep_blue</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 词组 chip(v1.2.0):用于主页字卡下方展示该字组成的词组,点击即朗读 -->
    <style name="Widget.StudyWord.WordChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipBackgroundColor">@color/sky_blue</item>
        <item name="android:textColor">@color/deep_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>