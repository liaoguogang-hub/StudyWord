<?xml version="1.0" encoding="utf-8"?>
<!--
    主页根布局:FrameLayout > NestedScrollView > ConstraintLayout(wrap_content) + confettiOverlay

    v1.2.0 修复:加词组/例句后字卡增高,底部 4 个按钮被挤出屏幕,改用 NestedScrollView。
    v1.3.0 新增:
      - 顶部"中文 / ENGLISH"语言切换 chip(languageChipGroup),持久化到 ProgressStore
      - 字卡内英文 letter 模式新增 uppercaseText + lowercaseText 两个 TextView
        (中文与英文 word 模式隐藏,英文 letter 模式显示 "Aa")
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".ui.MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌈 识字小帮手"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="一起开启有趣的识字冒险！"
                android:textColor="@color/gray_dark"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleText" />

            <!-- v1.3.0 新增:语言切换 chip group,中文 / ENGLISH 二选一 -->
            <TextView
                android:id="@+id/languageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="选择语言"
                android:textColor="@color/gray_dark"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitle" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/languageChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/languageLabel"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguageChinese"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中文" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguageEnglish"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENGLISH" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/difficultyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="选择任务难度"
                android:textColor="@color/gray_dark"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/languageChipGroup" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/difficultyChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/difficultyLabel"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEasy"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简单" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMedium"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中等" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHard"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="困难" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/currentCharacterCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:foregroundGravity="center"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/difficultyChipGroup">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/bg_card_playful">

                    <TextView
                        android:id="@+id/cardEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="32sp" />

                    <!--
                        currentCharacter:中文汉字 / 英文单词 显示此 TextView(60sp 大字)
                        英文 letter 模式隐藏,改用 uppercaseText + lowercaseText 双行
                    -->
                    <TextView
                        android:id="@+id/currentCharacter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="汉"
                        android:textColor="@color/deep_blue"
                        android:textSize="60sp"
                        android:textStyle="bold" />

                    <!-- v1.3.0:英文 letter 模式显示大写 -->
                    <TextView
                        android:id="@+id/uppercaseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textColor="@color/deep_blue"
                        android:textSize="60sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- v1.3.0:英文 letter 模式显示小写(单独一行,小字号) -->
                    <TextView
                        android:id="@+id/lowercaseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="a"
                        android:textColor="@color/gray_dark"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!--
                        拼音 / 音标共用此 TextView(中英文渲染相同字段 secondaryText)
                    -->
                    <TextView
                        android:id="@+id/currentPinyin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="hàn"
                        android:textColor="@color/gray_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/currentDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/difficulty_chip_background"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="简单"
                        android:textColor="@color/deep_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- 词组 + 例句(v1.2.0 新增),数据存在时才显示 -->
                    <View
                        android:id="@+id/wordsDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/sky_blue"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wordsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧩 词组"
                        android:textColor="@color/deep_blue"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/wordsChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="2dp"
                        app:singleLine="false"
                        app:singleSelection="false"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/examplesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="📖 例句"
                        android:textColor="@color/deep_blue"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/exampleSentence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text=""
                        android:textColor="@color/deep_blue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/remainingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="已认识 0 / 0 | 待巩固 0 | 未测 0"
                android:textColor="@color/deep_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/currentCharacterCard" />

            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/remainingHint">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unknownButton"
                    style="@style/Widget.StudyWord.UnknownButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="不认识" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/knowButton"
                    style="@style/Widget.StudyWord.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="认识啦！" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ttsRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/actionRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/listenButton"
                    style="@style/Widget.StudyWord.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="🔊 听一听"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipButton"
                    style="@style/Widget.StudyWord.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="换一个 ↻"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ttsRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewProgressButton"
                    style="@style/Widget.StudyWord.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="查看学习进度" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    style="@style/Widget.StudyWord.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="更多设置" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playGameButton"
                style="@style/Widget.StudyWord.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="🎮 玩游戏"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bottomActions" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/confettiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
