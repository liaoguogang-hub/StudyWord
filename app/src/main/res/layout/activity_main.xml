<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.2 主页根布局 — 顶栏只留右上角汉堡按钮(打开抽屉),其余 chrome 全移入抽屉
    - 删 titleText / subtitle(用户反馈"左上角内容太多,卡片首屏可见")
    - 删 englishSubModeGroup 顶部 margin,卡片直接贴在 NestedScrollView 顶部
    - 顶部加 backJumpButton(返回上一页)— 仅跳转来源 = 进度/字库时显示
    - 抽屉重设计:问候卡 + 语言/难度合并卡 + 3 张大入口卡(每张图+标题+副标题)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".ui.MainActivity">

    <!-- ======================================================== -->
    <!-- 主内容区(DrawerLayout 第一个 child,无 layout_gravity)      -->
    <!-- ======================================================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--
                    v1.4.2:英文 mode 时显示"字母 / 单词"子模式切换。
                    marginTop 0(原 6dp)— 标题已删除,直接紧贴顶部
                -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/englishSubModeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSubLetters"
                        style="@style/Widget.StudyWord.DifficultyChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔤 字母" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSubWords"
                        style="@style/Widget.StudyWord.DifficultyChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 单词" />
                </com.google.android.material.chip.ChipGroup>

                <!--
                    字卡:点击整张卡片用 v1.4.0 触发 speakCurrentItem()
                    v1.4.2:卡片本身不再 clickable,改由内部 letterContainer + 示例词 chip 单独响应
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/currentCharacterCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/englishSubModeGroup">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:background="@drawable/bg_card_playful"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/cardEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="48sp" />

                        <TextView
                            android:id="@+id/currentCharacter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="汉"
                            android:textColor="@color/deep_blue"
                            android:textSize="80sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/letterContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/uppercaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A"
                                android:textColor="@color/deep_blue"
                                android:textSize="80sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/lowercaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="a"
                                android:textColor="@color/gray_dark"
                                android:textSize="44sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/wordMeaning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text=""
                            android:textColor="@color/gray_dark"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/currentPinyin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="hàn"
                            android:textColor="@color/gray_dark"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/currentDifficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/difficulty_chip_background"
                            android:paddingStart="16dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="6dp"
                            android:text="简单"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/wordsDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/sky_blue"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/wordsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧩 词组"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/wordsChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="2dp"
                            app:singleLine="false"
                            app:singleSelection="false"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/examplesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="📖 例句"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/exampleSentence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text=""
                            android:textColor="@color/deep_blue"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/remainingHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="已认识 0 / 0 | 待巩固 0 | 未测 0"
                    android:textColor="@color/deep_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/currentCharacterCard" />

                <LinearLayout
                    android:id="@+id/actionRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/remainingHint">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/knowButton"
                        style="@style/Widget.StudyWord.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="😊"
                        android:textSize="38sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unknownButton"
                        style="@style/Widget.StudyWord.UnknownButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:text="😢"
                        android:textSize="38sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ttsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/actionRow">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/skipButton"
                        style="@style/Widget.StudyWord.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="➡️"
                        android:textSize="32sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playGameButton"
                        style="@style/Widget.StudyWord.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:text="🎮"
                        android:textSize="32sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 撒花层 -->
        <FrameLayout
            android:id="@+id/confettiOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!--
            v1.4.2:顶部"返回上一页"按钮 — 仅当 jumpSource != null 时显示
            平时 gone,不占位
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backJumpButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="← 返回"
            android:textColor="@color/deep_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:elevation="6dp" />

        <!--
            v1.4.1 右上角汉堡按钮 — 永久显示,打开抽屉
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/white"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="≡"
            android:textColor="@color/deep_blue"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="6dp" />

    </FrameLayout>

    <!-- ======================================================== -->
    <!-- v1.4.2 抽屉重设计 — 顶部问候 + 语言/难度合并 + 3 张大入口卡 -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部问候卡 — 立体 3D 糖果风 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_playful"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/drawerAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_drawer_avatar"
                android:gravity="center"
                android:text="🦄"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drawerGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="你好呀!"
                    android:textColor="@color/deep_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawerSubGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="今天一起学点什么呢?"
                    android:textColor="@color/gray_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 语言 + 难度合并卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_playful"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍 学习设置"
                android:textColor="@color/deep_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/languageLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="语言"
                android:textColor="@color/gray_dark"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/languageChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguageChinese"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇨🇳 中文" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguageEnglish"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇬🇧 ENGLISH" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/difficultyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="难度"
                android:textColor="@color/gray_dark"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/difficultyChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEasy"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简单" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMedium"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中等" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHard"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="困难" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- 浏览 section 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="📚 浏览"
            android:textColor="@color/gray_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 入口卡:学习进度 — 蓝紫渐变 -->
        <LinearLayout
            android:id="@+id/drawerProgressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_nav_blue"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_drawer_nav_icon"
                android:gravity="center"
                android:text="📊"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学习进度"
                    android:textColor="@color/deep_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="看掌握率、复习列表"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/deep_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 入口卡:字库浏览 — 粉橘渐变 -->
        <LinearLayout
            android:id="@+id/drawerLibraryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drawer_nav_pink"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_drawer_nav_icon"
                android:gravity="center"
                android:text="📖"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="字库浏览"
                    android:textColor="@color/deep_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="3000+ 字、26 字母、30 单词"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/deep_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 入口卡:更多设置 — 薄荷渐变 -->
        <LinearLayout
            android:id="@+id/drawerSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_drawer_nav_mint"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_drawer_nav_icon"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更多设置"
                    android:textColor="@color/deep_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="重置进度、导出 CSV"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/deep_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>