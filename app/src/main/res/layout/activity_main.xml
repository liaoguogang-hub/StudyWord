<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.4 主页根布局:
    - UI 回退到 v1.4.0 简约风(单色按钮、淡薄荷卡片、薄描边淡抽屉)
    - 汉堡按钮融入背景(透明无边框),与 topLabel 同高,不再有白圆圈
    - backJumpButton 同样融入背景,topLabel 位置不变,jumpSource 可见时动态 marginStart 让位
    - 抽屉左侧新增 drawerBackButton("←"),与抽屉整体同高,关闭抽屉回主页
    - 主页 padding 改回 v1.4.0 风格(24dp / 32dp / 24dp)
    - 字卡 padding 22dp → 24dp,cardCornerRadius 28dp → 26dp,cardElevation 8dp → 0dp(无阴影)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".ui.MainActivity">

    <!-- ======================================================== -->
    <!-- 主内容区(DrawerLayout 第一个 child,无 layout_gravity)      -->
    <!-- ======================================================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--
                    v1.4.3:顶部 label 显示"当前语言 · 难度"。纯文本,不 clickable。
                    中英文 mode 都显示,保证卡片起点位置永远一致。
                -->
                <TextView
                    android:id="@+id/topLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇨🇳 中文 · 难度 简单"
                    android:textColor="@color/deep_blue"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/currentCharacterCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/topLabel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:background="@drawable/bg_card_playful"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/cardEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="44sp" />

                        <TextView
                            android:id="@+id/currentCharacter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="汉"
                            android:textColor="@color/deep_blue"
                            android:textSize="80sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/letterContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/uppercaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A"
                                android:textColor="@color/deep_blue"
                                android:textSize="80sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/lowercaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="a"
                                android:textColor="@color/gray_dark"
                                android:textSize="44sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/wordMeaning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text=""
                            android:textColor="@color/gray_dark"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/currentPinyin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="hàn"
                            android:textColor="@color/gray_dark"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <!--
                            v1.4.3:删 currentDifficulty TextView(已搬到 topLabel)
                        -->

                        <View
                            android:id="@+id/wordsDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/sky_blue"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/wordsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧩 词组"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/wordsChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="2dp"
                            app:singleLine="false"
                            app:singleSelection="false"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/examplesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="📖 例句"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/exampleSentence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text=""
                            android:textColor="@color/deep_blue"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/remainingHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="已认识 0 / 0 | 待巩固 0 | 未测 0"
                    android:textColor="@color/deep_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/currentCharacterCard" />

                <LinearLayout
                    android:id="@+id/actionRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/remainingHint">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/knowButton"
                        style="@style/Widget.StudyWord.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="😊"
                        android:textSize="38sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unknownButton"
                        style="@style/Widget.StudyWord.UnknownButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:text="😢"
                        android:textSize="38sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ttsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/actionRow">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/skipButton"
                        style="@style/Widget.StudyWord.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="➡️"
                        android:textSize="32sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playGameButton"
                        style="@style/Widget.StudyWord.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:text="🎮"
                        android:textSize="32sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 撒花层 -->
        <FrameLayout
            android:id="@+id/confettiOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- v1.4.4:返回上一页按钮 — 仅 jumpSource != null 时可见;透明背景,融入主页底色 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backJumpButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:text="← 返回"
            android:textColor="@color/deep_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:elevation="0dp"
            app:rippleColor="@color/sky_blue" />

        <!-- v1.4.4:右上角汉堡按钮 — 透明背景,融入主页底色,与 topLabel 同高(40dp) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="≡"
            android:textColor="@color/deep_blue"
            android:textSize="28sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:elevation="0dp"
            app:rippleColor="@color/sky_blue" />

    </FrameLayout>

    <!-- ======================================================== -->
    <!-- v1.4.4 抽屉:左侧返回 + 问候 + 学习设置(3 chip) + 浏览(3 大入口卡) -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:elevation="0dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- v1.4.4:左侧返回主页按钮 + greeting 卡(同一行水平布局) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- v1.4.4 新增:抽屉左侧"←"返回主页按钮,与抽屉整体同高,透明背景 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawerBackButton"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="←"
                android:textColor="@color/deep_blue"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                app:rippleColor="@color/sky_blue" />

            <!-- 问候卡(占剩余宽度) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_playful"
                android:elevation="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/drawerAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_drawer_avatar"
                    android:gravity="center"
                    android:text="🦄"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drawerGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="你好呀!"
                        android:textColor="@color/deep_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/drawerSubGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="今天一起学点什么呢?"
                        android:textColor="@color/gray_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- v1.4.4:学习设置卡 — 语言 / 难度 / 子模式 3 组 chip,大小完全一致;无阴影 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_playful"
            android:elevation="0dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍 学习设置"
                android:textColor="@color/deep_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/languageLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🗣 语言"
                android:textColor="@color/gray_dark"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/languageChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguageChinese"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇨🇳 中文" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguageEnglish"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇬🇧 ENGLISH" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/difficultyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🎯 难度"
                android:textColor="@color/gray_dark"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/difficultyChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEasy"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简单" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMedium"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中等" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHard"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="困难" />
            </com.google.android.material.chip.ChipGroup>

            <!-- v1.4.3:英文 mode 才显示,中文 mode 隐藏 -->
            <TextView
                android:id="@+id/englishSubModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="📚 子模式"
                android:textColor="@color/gray_dark"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/englishSubModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSubLetters"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔤 字母" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSubWords"
                    style="@style/Widget.StudyWord.DifficultyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 单词" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="📚 浏览"
            android:textColor="@color/gray_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/drawerProgressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_nav_blue"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_drawer_nav_icon"
                android:gravity="center"
                android:text="📊"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学习进度"
                    android:textColor="@color/deep_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="看掌握率、复习列表"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/deep_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerLibraryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drawer_nav_pink"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_drawer_nav_icon"
                android:gravity="center"
                android:text="📖"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="字库浏览"
                    android:textColor="@color/deep_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="3000+ 字、26 字母、30 单词"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/deep_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_drawer_nav_mint"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_drawer_nav_icon"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更多设置"
                    android:textColor="@color/deep_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="重置进度、导出 CSV"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/deep_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>