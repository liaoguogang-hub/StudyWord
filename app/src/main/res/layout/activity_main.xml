<?xml version="1.0" encoding="utf-8"?>
<!--
    主页根布局:v1.4.0 改用 DrawerLayout 根,右侧抽屉收纳"语言/难度/进度/设置"。
    主页内容区只剩字卡 + 4 个底部按钮(认识/不认识/下一个/游戏),emoji 表示。

    v1.4.0 改动:
      - 顶层 FrameLayout → DrawerLayout
      - languageLabel + languageChipGroup + difficultyLabel + difficultyChipGroup
        全部移入抽屉(drawerContainer)
      - 删除 listenButton + viewProgressButton + settingsButton
      - 字卡字号加大(currentCharacter 60→80, words/example 16→22, cardEmoji 32→48)
      - 新增 menuButton(右上角汉堡按钮),点击抽屉
      - 新增 englishSubModeGroup(英文 mode 时显示,字母/单词 二选一)
      - 新增 difficultyGroup 在英文 mode 也显示,单词 mode 时按难度过滤
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".ui.MainActivity">

    <!-- ======================================================== -->
    <!-- 主内容区(DrawerLayout 第一个 child,无 layout_gravity)      -->
    <!-- ======================================================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--
                    v1.4.1:头部压缩 — 标题 22sp,去掉独立 subtitle 行,
                    把 welcome 语并入 englishSubModeGroup 同一行(英文 mode)。
                    节省纵向 ~50dp,卡片在 720dp 屏幕上首屏即可见 ~75% 内容。
                -->
                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌈 识字小帮手"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="一起开启有趣的识字冒险！"
                    android:textColor="@color/gray_dark"
                    android:textSize="12sp"
                    app:layout_constraintBaseline_toBaselineOf="@id/titleText"
                    app:layout_constraintStart_toEndOf="@id/titleText" />

                <!--
                    v1.4.0/v1.4.1:英文 mode 时显示"字母 / 单词"子模式切换。
                    v1.4.1 marginTop 12→6dp,贴近标题行;中文 mode 时整体隐藏。
                -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/englishSubModeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/titleText"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSubLetters"
                        style="@style/Widget.StudyWord.DifficultyChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔤 字母" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSubWords"
                        style="@style/Widget.StudyWord.DifficultyChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 单词" />
                </com.google.android.material.chip.ChipGroup>

                <!--
                    字卡:点击整张卡片用 v1.4.0 触发 speakCurrentItem()
                    v1.4.1:卡片本身不再 clickable,改由内部 letterContainer(字母行) + 示例词 chip 单独响应
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/currentCharacterCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/englishSubModeGroup">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:background="@drawable/bg_card_playful"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/cardEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="48sp" />

                        <!--
                            currentCharacter:中文汉字 / 英文单词 显示此 TextView
                            英文 letter 模式隐藏,改用 uppercaseText + lowercaseText 双行
                        -->
                        <TextView
                            android:id="@+id/currentCharacter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="汉"
                            android:textColor="@color/deep_blue"
                            android:textSize="80sp"
                            android:textStyle="bold" />

                        <!-- v1.3.0/v1.4.0/v1.4.1:英文 letter 模式显示大写 + 小写在一行
                            整个 letterContainer 可点击 → 只朗读字母名(uppercase) -->
                        <LinearLayout
                            android:id="@+id/letterContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/uppercaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A"
                                android:textColor="@color/deep_blue"
                                android:textSize="80sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/lowercaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="a"
                                android:textColor="@color/gray_dark"
                                android:textSize="44sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- v1.4.1:英文 word 模式下显示中文意思(单词释义),与字母卡的中文 hint 对齐 -->
                        <TextView
                            android:id="@+id/wordMeaning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text=""
                            android:textColor="@color/gray_dark"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/currentPinyin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="hàn"
                            android:textColor="@color/gray_dark"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/currentDifficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/difficulty_chip_background"
                            android:paddingStart="16dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="6dp"
                            android:text="简单"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- 词组 + 例句(v1.2.0/v1.4.0),字号加大 -->
                        <View
                            android:id="@+id/wordsDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/sky_blue"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/wordsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧩 词组"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/wordsChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="2dp"
                            app:singleLine="false"
                            app:singleSelection="false"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/examplesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="📖 例句"
                            android:textColor="@color/deep_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/exampleSentence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text=""
                            android:textColor="@color/deep_blue"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/remainingHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="已认识 0 / 0 | 待巩固 0 | 未测 0"
                    android:textColor="@color/deep_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/currentCharacterCard" />

                <!--
                    v1.4.0:4 个按钮 emoji 化
                    - 😊 认识 → knowButton(PrimaryButton)
                    - 😢 不认识 → unknownButton(UnknownButton)
                    - ➡️ 下一个 → skipButton(SecondaryButton,大 emoji)
                    - 🎮 游戏 → playGameButton(PrimaryButton,大 emoji)

                    监听按钮已被删除,字卡点击即发音
                    查看进度 + 更多设置已移入抽屉
                -->
                <LinearLayout
                    android:id="@+id/actionRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/remainingHint">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/knowButton"
                        style="@style/Widget.StudyWord.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="😊"
                        android:textSize="38sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unknownButton"
                        style="@style/Widget.StudyWord.UnknownButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:text="😢"
                        android:textSize="38sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ttsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/actionRow">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/skipButton"
                        style="@style/Widget.StudyWord.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="➡️"
                        android:textSize="32sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playGameButton"
                        style="@style/Widget.StudyWord.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:text="🎮"
                        android:textSize="32sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 撒花层:FrameLayout 顶层,clickable=false 透传点击 -->
        <FrameLayout
            android:id="@+id/confettiOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- 右上角汉堡按钮:点击打开抽屉 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/white"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="≡"
            android:textColor="@color/deep_blue"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

    </FrameLayout>

    <!-- ======================================================== -->
    <!-- 右侧抽屉:语言/难度/进度/设置                              -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎛 设置"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/sky_blue" />

        <TextView
            android:id="@+id/languageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌍 选择语言"
            android:textColor="@color/gray_dark"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/languageChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLanguageChinese"
                style="@style/Widget.StudyWord.DifficultyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇨🇳 中文" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLanguageEnglish"
                style="@style/Widget.StudyWord.DifficultyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇬🇧 ENGLISH" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/difficultyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🎯 选择任务难度"
            android:textColor="@color/gray_dark"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/difficultyChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEasy"
                style="@style/Widget.StudyWord.DifficultyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="简单" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMedium"
                style="@style/Widget.StudyWord.DifficultyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中等" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHard"
                style="@style/Widget.StudyWord.DifficultyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="困难" />
        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:background="@color/sky_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewProgressButton"
            style="@style/Widget.StudyWord.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="📊 学习进度"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/libraryButton"
            style="@style/Widget.StudyWord.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="📚 字库浏览"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Widget.StudyWord.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="⚙️ 更多设置"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>