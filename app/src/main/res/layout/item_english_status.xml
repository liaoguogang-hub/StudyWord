<?xml version="1.0" encoding="utf-8"?>
<!--
    字库英文项(letter / word)单元格布局。
    中文用 item_character_status.xml,英文用此 layout;
    两套 layout 字段一致:大字(primaryText) + 副字(phonetic) + 状态标签。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="@dimen/radius_chip"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <!--
            letter 模式:"Aa"(uppercase + lowercase 一行),word 模式:单词
            长单词(brother / elephant)在 4 列网格里放不下,必须自动缩字。
            注意:AppCompatTextView 认的是 **app:autoSizeTextType**,
            只写 android:autoSizeTextType 不生效(会保持固定 22sp → 被省略号截断)。
        -->
        <TextView
            android:id="@+id/characterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/en_char_placeholder"
            android:textColor="@color/deep_blue"
            android:textSize="22sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="22sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/phoneticText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/en_phonetic_placeholder"
            android:textColor="@color/gray_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_unknown"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:text="@string/status_placeholder"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
