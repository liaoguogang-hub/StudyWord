<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    tools:context=".game.GameActivity">

    <!-- 顶栏:返回 + 标题 + 进度 -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="返回"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🎮 识字闯关"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toStartOf="@id/progressText"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="1 / 5"
        android:textColor="@color/deep_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <!-- 模式 + 难度切换(v1.3.0:modeChipGroup 内含 4 个 chip,中英文两两一组,按语种显隐) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/modeChipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:selectionRequired="true"
        app:singleLine="false"
        app:singleSelection="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipListen"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 听音" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPinyin"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 看拼音" />

        <!-- v1.3.0 新增:英文题型 chip,默认隐藏,英文模式显示 -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipListenLetter"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔤 听字母"
            android:visibility="gone" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipListenWord"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 听单词"
            android:visibility="gone" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/difficultyChipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleLine="false"
        app:singleSelection="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeChipGroup">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEasy"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="简单" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMedium"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中等" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHard"
            style="@style/Widget.StudyWord.DifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="困难" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 题目区:听音模式显示喇叭按钮;拼音模式显示大字拼音 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/questionCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/difficultyChipGroup">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_playful"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 听音模式:喇叭按钮 + 提示文字 -->
            <ImageButton
                android:id="@+id/speakPromptButton"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_status_pill"
                android:contentDescription="点我听"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:scaleType="centerInside"
                android:padding="20dp" />

            <TextView
                android:id="@+id/speakPromptHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="点喇叭,听声音"
                android:textColor="@color/gray_dark"
                android:textSize="14sp" />

            <!-- 看拼音模式:大字号拼音 -->
            <TextView
                android:id="@+id/pinyinPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tiān"
                android:textColor="@color/deep_blue"
                android:textSize="48sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4 选项:2x2 grid -->
    <GridLayout
        android:id="@+id/optionsGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionCard">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionA"
            style="@style/Widget.StudyWord.OptionButton"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:text="字"
            android:textSize="44sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionB"
            style="@style/Widget.StudyWord.OptionButton"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:text="字"
            android:textSize="44sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionC"
            style="@style/Widget.StudyWord.OptionButton"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="8dp"
            android:text="字"
            android:textSize="44sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionD"
            style="@style/Widget.StudyWord.OptionButton"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_marginStart="8dp"
            android:text="字"
            android:textSize="44sp" />
    </GridLayout>

    <!-- 跳过按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipButton"
        style="@style/Widget.StudyWord.SecondaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="跳过 ↻"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/optionsGrid" />

    <!-- 撒花覆盖层 -->
    <FrameLayout
        android:id="@+id/confettiOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 收尾页:星星评级 + 再来一轮 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_playful"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/resultEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="56sp" />

            <TextView
                android:id="@+id/resultStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="⭐⭐⭐"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="太棒了!"
                android:textColor="@color/deep_blue"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="答对 5 / 5"
                android:textColor="@color/gray_dark"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/replayButton"
                style="@style/Widget.StudyWord.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="再来一轮 ↻"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                style="@style/Widget.StudyWord.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="返回主页"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
