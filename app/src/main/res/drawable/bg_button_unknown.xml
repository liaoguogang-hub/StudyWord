<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.3 升级:3D 糖果"不认识/重置"按钮
    - 去掉顶部 31% 白色高光(白字看不清)
    - 渐变从浅橙色起点改为深红色顶部 → 橘红底部
    - 整体保持深色,白色文字有清晰对比度
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#A8341F"
                android:centerColor="@color/tangerine"
                android:endColor="@color/tangerine"
                android:angle="270"
                android:type="linear" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
</layer-list>