<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.4:UI 简约化 — "不认识/重置"按钮回退到 v1.4.0 风格
    deep_blue → sky_blue 90° 垂直渐变 + 1dp 深蓝描边,白字清晰
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:startColor="@color/deep_blue"
        android:endColor="@color/sky_blue"
        android:angle="90" />
    <stroke
        android:width="1dp"
        android:color="@color/deep_blue" />
    <padding
        android:left="18dp"
        android:top="12dp"
        android:right="18dp"
        android:bottom="12dp" />
</shape>