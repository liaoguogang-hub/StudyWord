<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.4:UI 简约化 — 卡片背景回退到 v1.4.0 风格
    单层 white → mint → white 90° 渐变,无描边无高光,清爽
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:startColor="@color/white"
        android:centerColor="@color/mint"
        android:endColor="@color/white"
        android:angle="90" />
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>