<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.2:抽屉"更多设置"入口卡 — 薄荷 + 天蓝 + 浅薰衣草渐变 + 顶部高光
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/deep_blue" />
        </shape>
    </item>
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="19.5dp" />
            <gradient
                android:startColor="@color/mint"
                android:centerColor="@color/sky_blue"
                android:endColor="@color/lavender"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="19.5dp" android:topRightRadius="19.5dp" />
            <gradient
                android:startColor="#40FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
</layer-list>