<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.4.1:3D 糖果次按钮(抽屉里 3 个导航按钮 + 主页 4 个 emoji 按钮外的 ➡️)
    主体白底 + 2.5dp 深蓝描边 + 顶部高光,清爽但有立体感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/deep_blue" />
        </shape>
    </item>
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="21.5dp" />
            <gradient
                android:startColor="@color/white"
                android:centerColor="@color/white"
                android:endColor="@color/mint"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="21.5dp" android:topRightRadius="21.5dp" />
            <gradient
                android:startColor="#40FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
</layer-list>